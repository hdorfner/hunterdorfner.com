{
  "name": "hunterdorfner-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hunter Dorfner \u2014 operations, technology and analytics portfolio.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run format:check && npm run check && npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.0"
  }
}
