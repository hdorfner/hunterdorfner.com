---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="This page could not be found. Return to Hunter Dorfner’s portfolio or browse the projects."
  noindex
>
  <div class="container empty-404">
    <p class="eyebrow">404 / Page not found</p>
    <h1>A different route?</h1>
    <p class="lead">This page may have moved, or the address may be incomplete.</p>
    <div class="hero-actions">
      <a class="button" href="/">
        Return home
      </a>
      <a class="button secondary" href="/projects/">
        Explore projects
      </a>
    </div>
  </div>
</Layout>
