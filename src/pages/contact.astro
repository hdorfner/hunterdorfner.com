---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---

<Layout
  title="Contact"
  description="Connect with Hunter Dorfner about operations, technology, analytics, professional opportunities, or a project idea. Email or find him on LinkedIn."
>
  <div class="container">
    <PageIntro
      eyebrow="Let’s connect"
      title="A conversation is a good place to start."
      description="I’m happy to connect about operations, technology, new opportunities, or something you’re working on."
    />
    <div class="contact-grid">
      <div>
        <a class="contact-link" href={`mailto:${site.email}`}>
          <span>Email</span>
          <strong>{site.email} ↗</strong>
        </a>
        <a class="contact-link" href={site.linkedin}>
          <span>LinkedIn</span>
          <strong>linkedin.com/in/hunter-dorfner ↗</strong>
        </a>
      </div>
      <aside class="note-panel">
        <p class="eyebrow">Pittsburgh, Pennsylvania</p>
        <h2>Bring your perspective.</h2>
        <p>
          Whether you work in supply chain, build software, or run a business, I’m interested in how
          you approach the problems in front of you.
        </p>
      </aside>
    </div>
  </div>
</Layout>
