---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { projects } from '../data/projects';
import { skills } from '../data/site';
---

<Layout
  title="Hunter Dorfner"
  description="I use operations experience, data, technology, and leadership to solve complex problems and build better systems. Explore my work and what I’m learning."
>
  <div class="container">
    <section class="hero" id="introduction">
      <div>
        <p class="positioning">Supply Chain · Operations · Technology</p>
        <h1>
          Hunter
          <br />
          Dorfner
          <span class="hero-period" style="color:var(--blue)">
            .
          </span>
        </h1>
        <p class="lead">
          I use operations experience, data, and technology to solve complex problems and build
          better systems.
        </p>
        <div class="hero-actions">
          <a class="button" href="/projects/">
            Explore my work <span aria-hidden="true">↗</span>
          </a>
          <a class="button secondary" href="/about/">
            More about me
          </a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="How I approach my work">
        <p class="aside-heading">Where experience meets curiosity</p>
        <div class="focus-item">
          <span class="focus-number">01</span>
          <div>
            <h2>Understand the operation.</h2>
            <p>Start with the people, the process, and the work happening on the ground.</p>
          </div>
        </div>
        <div class="focus-item">
          <span class="focus-number">02</span>
          <div>
            <h2>Make the data useful.</h2>
            <p>Turn information into a clearer decision and a practical next step.</p>
          </div>
        </div>
        <div class="focus-item">
          <span class="focus-number">03</span>
          <div>
            <h2>Build what comes next.</h2>
            <p>Improve the system. Keep learning. Put ideas into practice.</p>
          </div>
        </div>
        <p class="location">Based in Pittsburgh, Pennsylvania</p>
      </aside>
    </section>
    <section class="section section-border">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>
            Real experience.
            <br />
            New possibilities.
          </h2>
        </div>
        <a class="text-link" href="/projects/">
          View all projects <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="project-grid">
        {projects.slice(0, 2).map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))}
      </div>
    </section>
    <section class="section section-border current-work" id="experience">
      <div>
        <p class="eyebrow">Currently</p>
        <h2>
          Close to the work.
          <br />
          Thinking ahead.
        </h2>
      </div>
      <div>
        <h3>Armada Supply Chain Solutions</h3>
        <p class="role">Supply Chain Coordinator – Transportation</p>
        <p>
          I work in transportation coordination, where clear communication and follow-through matter
          every day. Alongside that work, I’m expanding how I use analytics and development to
          understand and improve systems.
        </p>
        <a class="text-link" href="/experience/">
          Explore my experience <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="section section-border">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The toolkit</p>
          <h2>Tools with a purpose.</h2>
        </div>
      </div>
      <div class="skills-grid">
        {skills.map((skill) => (
          <article class="skill-item">
            <h3>{skill.title}</h3>
            <p class="tools">{skill.tools}</p>
            <p>{skill.context}</p>
            <a href={skill.href}>{skill.link}</a>
          </article>
        ))}
      </div>
    </section>
    <section id="education" class="section section-border">
      <p class="eyebrow">Penn State foundation</p>
      <div class="current-work">
        <h2>
          Business perspective.
          <br />
          Technical curiosity.
        </h2>
        <div>
          <p>
            Supply Chain &amp; Information Systems at Penn State’s Smeal College of Business, with
            minors in Information Sciences &amp; Technology and International Business.
          </p>
          <a class="text-link" href="/about/#education">
            Education &amp; background <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
    <div id="contact">
      <ContactCTA />
    </div>
  </div>
</Layout>
