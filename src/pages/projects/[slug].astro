---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const sectionId = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/-$/, '');
---

<Layout title={project.title} description={project.summary}>
  <div class="container">
    <section class="case-intro">
      <a href="/projects/" class="back-link">
        ← All projects
      </a>
      <div class="case-top">
        <div>
          <p class="eyebrow">{project.category}</p>
          <h1>{project.title}</h1>
          <p class="lead">{project.summary}</p>
        </div>
        <aside class="case-stat" aria-label="Project at a glance">
          <strong>{project.metric}</strong>
          <p>{project.metricLabel}</p>
        </aside>
      </div>
      <ul class="tags" aria-label="Project skills">
        {project.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      {project.demo && (
        <a class="button" href={project.demo.href}>
          {project.demo.label}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </section>
    <dl class="case-meta">
      <div>
        <dt>Context</dt>
        <dd>{project.year}</dd>
      </div>
      <div>
        <dt>My role</dt>
        <dd>{project.role}</dd>
      </div>
      <div>
        <dt>Status</dt>
        <dd>{project.status}</dd>
      </div>
    </dl>
    <p class="notice">{project.note}</p>
    <div class="case-content">
      <nav class="case-toc" aria-label="Case study sections">
        <p class="eyebrow">In this case study</p>
        {project.sections.map((section) => (
          <a href={`#${sectionId(section.title)}`}>{section.title}</a>
        ))}
      </nav>
      <div>
        {project.sections.map((section) => (
          <section class="case-section" id={sectionId(section.title)}>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}
        <a class="text-link" href="/projects/">
          Explore the rest of my work <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
